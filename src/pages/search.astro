---
import SearchBar from '@components/layout/SearchBar.astro';
import BrowsePageHeader from '@components/layout/BrowsePageHeader.astro';
import BrowseLayout from '@layouts/BrowseLayout.astro';
---

<BrowseLayout
  title='Search verified troubleshooting cases'
  description='Search verified, version-specific software troubleshooting cases by error message, tool, version, or topic.'
  pageTitle='TroubleFactory | Search'
>
  <div class='browse-search'>
    <BrowsePageHeader
      eyebrow='Search'
      title='Search cases'
      description='Find verified fixes by error message, tool, version, or topic.'
    />
    <div class='mt-4'>
      <SearchBar size='hero' autofocus />
    </div>
    <p class='browse-search__meta' data-search-meta></p>
    <ul class='browse-case-list browse-search__results' data-search-results></ul>
  </div>
</BrowseLayout>

<script>
  import '../scripts/search-page.ts';
</script>

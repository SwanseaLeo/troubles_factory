---
import { getCollection, render } from 'astro:content';
import Layout from '@layouts/BlogPost.astro';
import { extractCaseVersions, getPublishedCases, getRelatedCases } from '../../utils/cases';
import { inferCaseMeta } from '../../utils/home-data';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((blogpost) => ({
    params: { slug: blogpost.id },
    props: { blogpost },
  }));
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

const { blogpost } = Astro.props;
const { Content } = await render(blogpost);
const headings = blogpost.rendered?.metadata?.headings as Heading[] | undefined;

const allPosts = await getPublishedCases();
const relatedCases = getRelatedCases(allPosts, blogpost);
const versions = extractCaseVersions(blogpost);
const meta = inferCaseMeta(blogpost);
---

<Layout
  title={blogpost.data.title}
  description={blogpost.data.description}
  pubDate={blogpost.data.pubDate}
  author={blogpost.data.author}
  headings={headings}
  imgSrc={blogpost.data.imgUrl}
  tags={blogpost.data.tags}
  slug={blogpost.id}
  {relatedCases}
  {versions}
  {meta}
>
  <Content />
</Layout>

---
import BlogList from '@components/blog/BlogList.astro';
import BrowseLayout from '@layouts/BrowseLayout.astro';
import { getPublishedCases } from '../../utils/cases';

const posts = await getPublishedCases();
---

<BrowseLayout
  title='Cases'
  description='Browse all documented software issues and solutions'
  pageTitle='Troubles Factory Cases'
>
  <div class='mb-6'>
    <h1 class='outfit text-2xl font-semibold md:text-3xl'>All cases</h1>
    <p class='mt-1 poppins text-sm text-black/55'>
      {posts.length} documented {posts.length === 1 ? 'issue' : 'issues'}
    </p>
  </div>
  <BlogList posts={posts} />
</BrowseLayout>

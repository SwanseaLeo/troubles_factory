---
import BlogList from '@components/blog/BlogList.astro';
import BrowsePageHeader from '@components/layout/BrowsePageHeader.astro';
import BrowseLayout from '@layouts/BrowseLayout.astro';
import { getPublishedCases } from '../../utils/cases';

const posts = await getPublishedCases();
---

<BrowseLayout
  title='Verified software troubleshooting cases'
  description='Browse all verified, version-specific software troubleshooting cases with reproducible fixes.'
  pageTitle='TroubleFactory | All verified cases'
>
  <BrowsePageHeader
    eyebrow='Archive'
    title='All cases'
    description={`${posts.length} verified ${posts.length === 1 ? 'case' : 'cases'} with reproducible fixes.`}
  />
  <BlogList posts={posts} />
</BrowseLayout>

---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BlogList from '@components/blog/BlogList.astro';
import BrowsePageHeader from '@components/layout/BrowsePageHeader.astro';
import BrowseLayout from '@layouts/BrowseLayout.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog').then((collection) =>
    collection.sort((a, b) => b.id.localeCompare(a.id)),
  );

  const tags: string[] = [];

  allPosts.forEach((post) => {
    post.data.tags.forEach((tag) => {
      tags.push(tag.toLowerCase());
    });
  });

  return Array.from(new Set(tags)).map((tag) => ({
    params: { tag },
    props: {
      tag,
      blogposts: allPosts.filter((post) =>
        post.data.tags.map((t) => t.toLowerCase()).includes(tag),
      ),
    },
  }));
}

interface Props {
  tag: string;
  blogposts: CollectionEntry<'blog'>[];
}

const { tag, blogposts } = Astro.props;
const tagLabel = blogposts[0]?.data.tags.find(
  (item) => item.toLowerCase() === tag,
) ?? tag;
---

<BrowseLayout
  title={`${tagLabel} troubleshooting cases`}
  description={`Verified software troubleshooting cases tagged with ${tagLabel}.`}
  pageTitle={`TroubleFactory | Cases tagged with ${tagLabel}`}
>
  <BrowsePageHeader
    eyebrow='Topic'
    title={tagLabel}
    description={`${blogposts.length} verified ${blogposts.length === 1 ? 'case' : 'cases'} for ${tagLabel}.`}
    backHref='/cases/'
    backLabel='All cases'
  />
  <BlogList posts={blogposts} />
</BrowseLayout>

---
import ErrorPage from '@components/errors/404.astro';
import RecentBlogPosts from '@components/generic/RecentBlogPosts.astro';
import Layout from '@layouts/Default.astro';
---

<Layout
  title='Page Not Found'
  description='The page you requested could not be found. Search verified troubleshooting cases or browse all cases.'
  classList='bg-tf-surface-page dark:bg-neutral-950'
  pageTitle='Page Not Found'
>
  <main id='main-content' class='mx-auto max-w-5xl px-6 py-24'>
    <ErrorPage />
    <RecentBlogPosts />
  </main>
</Layout>

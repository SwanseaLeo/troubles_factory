---
import ComparisonSection from '@components/home/ComparisonSection.astro';
import HeroSection from '@components/home/HeroSection.astro';
import LatestCasesSection from '@components/home/LatestCasesSection.astro';
import NewsletterSection from '@components/home/NewsletterSection.astro';
import StatsSection from '@components/home/StatsSection.astro';
import TechnologyGrid from '@components/home/TechnologyGrid.astro';
import WhySection from '@components/home/WhySection.astro';
import HomeSeoContent from '@components/seo/HomeSeoContent.astro';
import HomeStructuredData from '@components/seo/HomeStructuredData.astro';
import Layout from '@layouts/Default.astro';
import '../styles/home.css';
import { buildTagIndex, getPublishedCases } from '../utils/cases';
import {
  buildHomeStats,
  buildPopularSearches,
  buildTechnologyStats,
  buildTrendingCases,
} from '../utils/home-data';
import {
  buildHomeKeywords,
  buildLatestUpdatedCases,
  buildPopularTechnologies,
  buildPopularVersionLinks,
  type HomeSeoContext,
} from '../utils/home-seo';

const posts = await getPublishedCases();
const tags = buildTagIndex(posts);
const suggestions = buildPopularSearches(tags);
const technologies = buildTechnologyStats(posts);
const stats = buildHomeStats(posts);
const trendingPosts = buildTrendingCases(posts);
const latestPosts = posts.slice(0, 4);
const latestUpdatedCases = buildLatestUpdatedCases(posts);
const popularTechnologies = buildPopularTechnologies(technologies);
const popularVersions = buildPopularVersionLinks(posts);

const siteUrl = Astro.site?.toString() ?? 'https://troubles-factory.com/';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const pageTitle =
  'Verified Software Troubleshooting Database | Docker, Linux, NVIDIA, TensorRT';
const pageDescription =
  'Search verified, version-specific, reproducible software troubleshooting cases for Docker, Linux, NVIDIA, CUDA, TensorRT, ONNX, PyTorch, OpenCV, and production environments.';
const keywords = buildHomeKeywords(posts, technologies);

const seoContext: HomeSeoContext = {
  siteUrl,
  canonicalUrl,
  title: pageTitle,
  description: pageDescription,
  posts,
  technologies,
  stats,
};
---

<Layout
  title={pageTitle}
  pageTitle='TroubleFactory | Verified software fixes that actually work'
  description={pageDescription}
  keywords={keywords}
  ogSiteName='TroubleFactory'
  navVariant='minimal'
  footerVariant='home'
  classList='home-page bg-tf-surface-page dark:bg-neutral-950'
>
  <HomeStructuredData slot='head' context={seoContext} />

  <main id='main-content'>
    <HeroSection suggestions={suggestions} />
    <WhySection />
    <TechnologyGrid technologies={technologies} />
    <LatestCasesSection latestPosts={latestPosts} trendingPosts={trendingPosts} />
    <StatsSection stats={stats} />
    <ComparisonSection />
    <NewsletterSection />
    <HomeSeoContent
      popularTechnologies={popularTechnologies}
      popularVersions={popularVersions}
      latestVerifiedCases={latestPosts}
      latestUpdatedCases={latestUpdatedCases}
      stats={stats}
    />
  </main>
</Layout>

---
import RecentBlogPosts from '@components/generic/RecentBlogPosts.astro';
import CommunityLinks from '@components/home/CommunityLinks.astro';
import MobileSocials from '@components/home/MobileSocials.astro';
import { Button, Card } from '@eliancodes/brutal-ui';
import Layout from '@layouts/Default.astro';
---

<Layout
  title='Home'
  pageTitle='Troubles Factory | Home'
  description='Troubles Factory website built on the Brutal Astro template.'
>
  <main class='bg-pink-theme p-6'>
    <MobileSocials />
    <section id='hero' class='mt-4'>
      <h2 class='hidden'>Troubles Factory</h2>
      <Card>
        <div class='flex flex-col items-start gap-4'>
          <p class='mt-4 outfit text-2xl md:text-5xl lg:text-7xl'>
            Troubles Factory
          </p>
          <p class='mt-2 outfit text-xl md:text-3xl lg:text-5xl'>
            Collecting programming challenges and providing practical solutions..
          </p>
          <Button target={'_self'} href='/cases/'>
            Visit our updates &rarr;
          </Button>
        </div>
      </Card>
    </section>
    <RecentBlogPosts />
    <section id='about' class='mt-8 flex flex-col gap-8'>
      <Card>
        <h2 class='text-xl md:text-2xl lg:text-3xl mb-3 dm-serif'>
          About Troubles Factory
        </h2>
        <p class='poppins text-sm md:text-base'>
          Troubles Factory is a knowledge base that collects software-related issues (including those related to architecture, code, and exceptions) and provides proven, truly implementable solutions.
        </p>
      </Card>
      <Card>
        <CommunityLinks />
      </Card>
    </section>
  </main>
</Layout>

---
// src/components/ui/ImageFrame.astro
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { imageFrameClasses } from '../../styles/design-system';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  hero?: boolean;
  contain?: boolean;
  width?: number;
  height?: number;
  caption?: string;
  class?: string;
}

const {
  src,
  alt,
  hero = false,
  contain = false,
  width = 1200,
  height = 600,
  caption,
  class: className,
} = Astro.props;

const frameClass = imageFrameClasses({ hero, contain }, className);
const isRemote = typeof src === 'string';
---

<figure class='not-prose'>
  <div class={frameClass}>
    {
      isRemote ? (
        <img src={src} alt={alt} width={width} height={height} loading='lazy' decoding='async' />
      ) : (
        <Image src={src} alt={alt} width={width} height={height} loading='lazy' decoding='async' />
      )
    }
  </div>
  {caption && <figcaption class='tf-image-caption'>{caption}</figcaption>}
</figure>

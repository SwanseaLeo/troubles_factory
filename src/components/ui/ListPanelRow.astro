---
// src/components/ui/ListPanelRow.astro
import { listPanelRowClasses } from '../../styles/design-system';

interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const classes = listPanelRowClasses(className);
---

{
  href ? (
    <li>
      <a href={href} class={classes}>
        <slot />
      </a>
    </li>
  ) : (
    <li class={classes}>
      <slot />
    </li>
  )
}

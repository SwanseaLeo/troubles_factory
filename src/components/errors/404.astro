---
import Button from '@components/ui/Button.astro';
---

<section class='flex flex-col gap-8'>
  <p class='font-[family-name:var(--font-tf-display)] text-8xl font-bold tracking-tight text-tf-text md:text-9xl dark:text-neutral-50' aria-hidden='true'>
    404
  </p>
  <h1 class='tf-text-display-2xl'>Page Not Found</h1>
  <p class='tf-text-body-lg max-w-xl'>
    Sorry, we could not find the page you were looking for. Try searching verified cases or return home.
  </p>
  <Button href='/' variant='secondary' size='lg' class='w-fit'>
    &larr; Go Home
  </Button>
</section>

---
import Button from '@components/ui/Button.astro';
import SearchBar from '@components/layout/SearchBar.astro';
---

<section class='error-page not-prose'>
  <p class='error-page__code' aria-hidden='true'>404</p>
  <h1 class='error-page__title'>Page not found</h1>
  <p class='error-page__description'>
    We could not find the page you were looking for. Search verified cases or browse the archive.
  </p>
  <div class='error-page__actions'>
    <Button href='/' variant='secondary' size='lg'>
      &larr; Go home
    </Button>
    <Button href='/cases/' variant='ghost' size='lg'>
      Browse all cases
    </Button>
  </div>
  <div class='error-page__section'>
    <h2 class='error-page__section-title'>Search cases</h2>
    <SearchBar size='hero' />
  </div>
</section>

---
interface Suggestion {
  query: string;
  label: string;
}

interface Props {
  suggestions: Suggestion[];
}

const { suggestions } = Astro.props;
---

{
  suggestions.length > 0 && (
    <div class='mt-5 w-full'>
      <p class='poppins text-center text-xs text-black/45 mb-2'>Try searching for</p>
      <ul class='flex flex-wrap justify-center gap-2'>
        {suggestions.map((item) => (
          <li>
            <a
              href={`/search?q=${encodeURIComponent(item.query)}`}
              class='inline-block rounded-full border border-black/15 bg-white px-3 py-1 poppins text-sm text-black/70 transition-colors hover:border-black/30 hover:bg-black/5 hover:text-black'
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

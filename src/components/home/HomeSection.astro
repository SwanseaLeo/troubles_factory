---
// src/components/home/HomeSection.astro
interface Props {
  id?: string;
  labelledBy?: string;
  class?: string;
  muted?: boolean;
}

const { id, labelledBy, class: className, muted = false } = Astro.props;
---

<section
  id={id}
  class:list={['home-section', muted && 'home-section--muted', className]}
  aria-labelledby={labelledBy}
>
  <div class='home-section__inner'>
    <slot />
  </div>
</section>

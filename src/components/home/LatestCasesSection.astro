---
import type { CollectionEntry } from 'astro:content';
import CaseCard from './CaseCard.astro';
import HomeSection from './HomeSection.astro';
import TrendingPanel from './TrendingPanel.astro';

interface Props {
  latestPosts: CollectionEntry<'blog'>[];
  trendingPosts: CollectionEntry<'blog'>[];
}

const { latestPosts, trendingPosts } = Astro.props;
---

<HomeSection id='latest-verified-cases' labelledBy='latest-cases-title'>
  <div class='home-section__header'>
    <div>
      <p class='tf-text-label home-section__eyebrow'>Latest Verified Cases</p>
      <h2 id='latest-cases-title' class='tf-text-display-2xl'>
        Recently validated fixes
      </h2>
    </div>
    <a href='/cases/' class='home-section__link'>Browse all cases →</a>
  </div>

  <div class='home-cases-layout'>
    <ul class='home-cases-grid'>
      {
        latestPosts.map((post) => (
          <li class='min-h-0'>
            <CaseCard post={post} />
          </li>
        ))
      }
    </ul>
    <TrendingPanel posts={trendingPosts} />
  </div>
</HomeSection>

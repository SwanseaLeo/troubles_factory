---
// src/components/home/CaseCard.astro
import type { CollectionEntry } from 'astro:content';
import StatusBadge from '@components/ui/StatusBadge.astro';
import Tag from '@components/ui/Tag.astro';
import {
  formatVerifiedDate,
  inferCaseMeta,
  type CaseDisplayMeta,
} from '../../utils/home-data';

interface Props {
  post: CollectionEntry<'blog'>;
  meta?: CaseDisplayMeta;
}

const { post, meta = inferCaseMeta(post) } = Astro.props;
const href = `/cases/${post.id}/`;
---

<article
  class='home-case-card'
  itemscope
  itemtype='https://schema.org/TechArticle'
>
  <a href={href} class='home-case-card__link' itemprop='url'>
    <div class='home-case-card__badges'>
      <StatusBadge variant='verified' dot>Verified</StatusBadge>
      <StatusBadge variant='reproduced'>Production tested</StatusBadge>
    </div>

    <h3 class='home-case-card__title' itemprop='headline'>
      {post.data.title}
    </h3>

    <p class='home-case-card__description' itemprop='description'>
      {post.data.description}
    </p>

    <dl class='home-case-card__meta'>
      <div class='home-case-card__meta-row'>
        <dt class='home-case-card__meta-dt'>Environment</dt>
        <dd class='home-case-card__meta-dd'>{meta.environment}</dd>
      </div>
      <div class='home-case-card__meta-row'>
        <dt class='home-case-card__meta-dt'>Version</dt>
        <dd class='home-case-card__meta-dd home-case-card__meta-dd--mono'>
          {meta.version}
        </dd>
      </div>
      <div class='home-case-card__meta-row'>
        <dt class='home-case-card__meta-dt'>Framework</dt>
        <dd class='home-case-card__meta-dd'>{meta.framework}</dd>
      </div>
      <div class='home-case-card__meta-row'>
        <dt class='home-case-card__meta-dt'>Verified</dt>
        <dd class='home-case-card__meta-dd'>
          <time datetime={post.data.pubDate.toISOString()}>
            {formatVerifiedDate(post.data.pubDate)}
          </time>
        </dd>
      </div>
    </dl>

    {
      post.data.tags.length > 0 && (
        <div class='home-case-card__tags'>
          {post.data.tags.slice(0, 4).map((tag) => (
            <Tag label={tag} pill>
              {tag}
            </Tag>
          ))}
        </div>
      )
    }
  </a>
</article>

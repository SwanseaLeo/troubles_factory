---
// src/components/home/CaseCard.astro
import type { CollectionEntry } from 'astro:content';
import StatusBadge from '@components/ui/StatusBadge.astro';
import Tag from '@components/ui/Tag.astro';
import {
  formatVerifiedDate,
  inferCaseMeta,
  type CaseDisplayMeta,
} from '../../utils/home-data';

interface Props {
  post: CollectionEntry<'blog'>;
  meta?: CaseDisplayMeta;
}

const { post, meta = inferCaseMeta(post) } = Astro.props;
const href = `/cases/${post.id}/`;
---

<article class='home-case-card h-full rounded-tf-lg border border-tf-border bg-tf-surface dark:border-neutral-800 dark:bg-neutral-950' itemscope itemtype='https://schema.org/TechArticle'>
  <a href={href} class='flex h-full flex-col p-5' itemprop='url'>
    <div class='mb-3 flex flex-wrap items-center gap-2'>
      <StatusBadge variant='verified'>Verified</StatusBadge>
      <StatusBadge variant='reproduced'>Production tested</StatusBadge>
    </div>

    <h3 class='font-[family-name:var(--font-tf-display)] text-lg font-semibold leading-snug text-tf-brand dark:text-blue-400' itemprop='headline'>
      {post.data.title}
    </h3>

    <p class='mt-2 flex-1 font-[family-name:var(--font-tf-ui)] text-sm leading-relaxed text-tf-text-secondary line-clamp-3 dark:text-neutral-400' itemprop='description'>
      {post.data.description}
    </p>

    <dl class='mt-4 grid gap-2 font-[family-name:var(--font-tf-ui)] text-xs text-tf-text-muted dark:text-neutral-500'>
      <div class='flex gap-2'>
        <dt class='w-24 shrink-0 font-medium text-tf-text-subtle'>Environment</dt>
        <dd class='text-tf-text-secondary dark:text-neutral-400'>{meta.environment}</dd>
      </div>
      <div class='flex gap-2'>
        <dt class='w-24 shrink-0 font-medium text-tf-text-subtle'>Version</dt>
        <dd class='font-[family-name:var(--font-tf-mono)] text-tf-text-secondary dark:text-neutral-400'>
          {meta.version}
        </dd>
      </div>
      <div class='flex gap-2'>
        <dt class='w-24 shrink-0 font-medium text-tf-text-subtle'>Framework</dt>
        <dd class='text-tf-text-secondary dark:text-neutral-400'>{meta.framework}</dd>
      </div>
      <div class='flex gap-2'>
        <dt class='w-24 shrink-0 font-medium text-tf-text-subtle'>Verified</dt>
        <dd>
          <time datetime={post.data.pubDate.toISOString()}>
            {formatVerifiedDate(post.data.pubDate)}
          </time>
        </dd>
      </div>
    </dl>

    {
      post.data.tags.length > 0 && (
        <div class='mt-4 flex flex-wrap gap-1.5'>
          {post.data.tags.slice(0, 4).map((tag) => (
            <Tag label={tag} pill>
              {tag}
            </Tag>
          ))}
        </div>
      )
    }
  </a>
</article>

---
import type { HomeStats } from '../../utils/home-data';
import HomeSection from './HomeSection.astro';

interface Props {
  stats: HomeStats;
}

const { stats } = Astro.props;

const items = [
  {
    label: 'Verified Cases',
    value: String(stats.verifiedCases),
    hint: 'Published, production-tested fixes',
  },
  {
    label: 'Versions',
    value: String(stats.versionCount),
    hint: 'Distinct version references across cases',
  },
  {
    label: 'Technologies',
    value: String(stats.technologyCount),
    hint: 'Active stacks with verified coverage',
  },
  {
    label: 'Verified Rate',
    value: stats.verifiedRate,
    hint: 'Published cases with documented verification',
  },
] as const;
---

<HomeSection id='knowledge-statistics' labelledBy='stats-title' muted>
  <div class='home-section__header home-section__header--narrow'>
    <div>
      <p class='tf-text-label home-section__eyebrow'>Knowledge Statistics</p>
      <h2 id='stats-title' class='tf-text-display-2xl'>
        Built from real production evidence
      </h2>
    </div>
  </div>

  <dl class='home-stats-grid'>
    {
      items.map((item) => (
        <div class='home-stat-card'>
          <dt class='home-stat-card__label'>{item.label}</dt>
          <dd class='home-stat-card__value'>
            {item.value}
            <span class='home-stat-card__hint'>{item.hint}</span>
          </dd>
        </div>
      ))
    }
  </dl>
  <p class='sr-only'>
    <a href='/cases/'>Browse all {stats.verifiedCases} verified troubleshooting cases</a>
  </p>
</HomeSection>

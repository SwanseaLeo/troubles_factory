---
// src/components/home/HomeFooter.astro
import SocialIcon from '@components/generic/SocialIcon.astro';
import { communityLinks } from '../../data/community-links';

const discordLink = communityLinks.find((link) => link.type === 'discord');

const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Search cases', href: '/search' },
      { label: 'All cases', href: '/cases/' },
      { label: 'RSS feed', href: '/feed.xml' },
    ],
  },
  {
    title: 'Technologies',
    links: [
      { label: 'Docker', href: '/cases/tags/docker/' },
      { label: 'Linux', href: '/cases/tags/linux/' },
      { label: 'NVIDIA', href: '/cases/tags/nvidia/' },
      { label: 'PyTorch', href: '/cases/tags/pytorch/' },
    ],
  },
  {
    title: 'Community',
    links: [
      ...(discordLink
        ? [{ label: 'Discord', href: discordLink.url, external: true }]
        : []),
      { label: 'RSS feed', href: '/feed.xml', external: false },
    ],
  },
] as const;
---

<footer class='border-t border-tf-border bg-tf-surface px-4 py-12 md:px-8 dark:border-neutral-800 dark:bg-neutral-950'>
  <div class='mx-auto max-w-6xl'>
    <div class='grid gap-10 md:grid-cols-[minmax(0,1.4fr)_repeat(3,minmax(0,1fr))]'>
      <div>
        <a href='/' title='TroubleFactory home'>
          <img
            src='/logo_a.png'
            alt='TroubleFactory'
            class='h-10 w-auto dark:brightness-110'
            loading='lazy'
            decoding='async'
          />
        </a>
        <p class='mt-4 max-w-sm font-[family-name:var(--font-tf-ui)] text-sm leading-relaxed text-tf-text-secondary dark:text-neutral-400'>
          Verified software troubleshooting knowledge — version-specific,
          reproducible, and production tested.
        </p>
        <ul class='mt-5 flex items-center gap-3'>
          {
            discordLink && (
              <li>
                <a
                  href={discordLink.url}
                  class='tf-focus-ring inline-flex rounded-tf-md p-2 text-tf-text-muted transition-colors hover:text-tf-brand dark:text-neutral-400 dark:hover:text-blue-400'
                  target='_blank'
                  rel='noopener noreferrer'
                  title='Discord'
                >
                  <SocialIcon icon='discord' class='h-5 w-5' />
                </a>
              </li>
            )
          }
          <li>
            <a
              href='/feed.xml'
              class='tf-focus-ring inline-flex rounded-tf-md p-2 text-tf-text-muted transition-colors hover:text-tf-brand dark:text-neutral-400 dark:hover:text-blue-400'
              title='RSS feed'
            >
              <SocialIcon icon='rss' class='h-5 w-5' />
            </a>
          </li>
        </ul>
      </div>

      {
        columns.map((column) => (
          <nav aria-label={column.title}>
            <h3 class='font-[family-name:var(--font-tf-ui)] text-xs font-semibold uppercase tracking-wide text-tf-text-subtle dark:text-neutral-500'>
              {column.title}
            </h3>
            <ul class='mt-4 space-y-2'>
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class='font-[family-name:var(--font-tf-ui)] text-sm text-tf-text-secondary transition-colors hover:text-tf-brand dark:text-neutral-400 dark:hover:text-blue-400'
                    target={'external' in link && link.external ? '_blank' : undefined}
                    rel={'external' in link && link.external ? 'noopener noreferrer' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class='mt-10 flex flex-col gap-2 border-t border-tf-border pt-6 font-[family-name:var(--font-tf-ui)] text-xs text-tf-text-subtle sm:flex-row sm:items-center sm:justify-between dark:border-neutral-800 dark:text-neutral-500'>
      <p>© {new Date().getFullYear()} TroubleFactory. Built with Astro.</p>
      <p>Every published case is verified before it ships.</p>
    </div>
  </div>
</footer>

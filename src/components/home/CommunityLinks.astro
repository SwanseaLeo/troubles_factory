---
import SocialIcon from '@components/generic/SocialIcon.astro';
import {
  communityLinks,
  type CommunityLink,
  type CommunityLinkType,
} from '../../data/community-links';

const iconByType: Partial<Record<CommunityLinkType, 'discord'>> = {
  discord: 'discord',
};

const accentByType: Partial<Record<CommunityLinkType, string>> = {
  discord: 'bg-[#5865F2]',
  telegram: 'bg-[#26A5E4]',
};

function getIcon(type: CommunityLinkType) {
  return iconByType[type];
}

function getAccent(type: CommunityLinkType) {
  return accentByType[type] ?? 'bg-white text-black';
}
---

<h2 class='text-xl md:text-2xl lg:text-3xl mb-4 dm-serif'>Community</h2>
<ul class='flex flex-wrap gap-4'>
  {
    communityLinks.map((item: CommunityLink) => {
      const icon = getIcon(item.type);
      const accent = getAccent(item.type);
      return (
        <li>
          <a
            class='group flex w-fit max-w-full items-center gap-4 rounded border-2 border-black bg-white px-4 py-3 card-shadow transition-all duration-150 hover:translate-x-0.5 hover:translate-y-0.5 hover:text-green-700'
            href={item.url}
            target='_blank'
            rel='noopener noreferrer'
            title={`Join ${item.name}`}
          >
            {
              icon && (
                <span
                  class={`flex h-11 w-11 shrink-0 items-center justify-center rounded border-2 border-black text-white ${accent}`}
                >
                  <SocialIcon icon={icon} class='h-6 w-6' />
                </span>
              )
            }
            <span class='flex min-w-0 flex-col'>
              <span class='sanchez text-base font-semibold leading-tight'>
                {item.name}
              </span>
              {
                item.description && (
                  <span class='poppins text-xs md:text-sm text-black/70 group-hover:text-green-700/80'>
                    {item.description}
                  </span>
                )
              }
            </span>
            <span
              class='poppins shrink-0 text-base transition-transform duration-150 group-hover:translate-x-0.5'
              aria-hidden='true'
            >
              &rarr;
            </span>
          </a>
        </li>
      );
    })
  }
</ul>

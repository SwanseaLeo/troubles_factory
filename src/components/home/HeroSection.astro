---
// src/components/home/HeroSection.astro
import StatusBadge from '@components/ui/StatusBadge.astro';
import HeroSearchCard from './HeroSearchCard.astro';

interface Suggestion {
  query: string;
  label: string;
}

interface Props {
  suggestions: Suggestion[];
}

const { suggestions } = Astro.props;

const trustIndicators = [
  'Verified',
  'Version-aware',
  'Reproducible',
  'Production Tested',
] as const;
---

<section
  id='hero'
  class='home-hero'
  aria-labelledby='home-hero-title'
>
  <div class='home-hero__inner'>
    <div class='home-hero__content'>
      <StatusBadge variant='verified' dot>
        Verified · Version-specific · Reproducible
      </StatusBadge>

      <div class='home-hero__headline-group'>
        <h1 id='home-hero-title' class='home-hero__title'>
          Verified Software Fixes<br />
          <span class='home-hero__title-accent'>That Actually Work.</span>
        </h1>
        <p class='home-hero__subtitle'>
          Search thousands of verified software troubleshooting cases validated
          in real production environments — not forum guesses or AI
          hallucinations.
        </p>
      </div>

      <ul class='home-hero__trust-list' aria-label='Trust indicators'>
        {
          trustIndicators.map((item) => (
            <li class='home-trust-pill'>
              <span class='home-trust-pill__dot' aria-hidden='true' />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <aside aria-label='Search verified cases'>
      <HeroSearchCard suggestions={suggestions} />
    </aside>
  </div>
</section>

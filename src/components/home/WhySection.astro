---
import Icon from '@components/ui/Icon.astro';
import type { LucideIconName } from '../../utils/lucide-icon';
import HomeSection from './HomeSection.astro';

const features: Array<{
  title: string;
  description: string;
  icon: LucideIconName;
}> = [
  {
    title: 'Verified',
    description:
      'Every published case is documented with reproducible steps and expected output — not anecdotal fixes.',
    icon: 'shield-check',
  },
  {
    title: 'Version Specific',
    description:
      'Cases call out the exact software, driver, and runtime versions where the fix was validated.',
    icon: 'tag',
  },
  {
    title: 'Reproducible',
    description:
      'Numbered procedures, prerequisites, and command output make it straightforward to confirm the same result.',
    icon: 'refresh-cw',
  },
  {
    title: 'Production Ready',
    description:
      'Written for operators shipping real workloads — rollback paths, risk notes, and verification included.',
    icon: 'zap',
  },
];
---

<HomeSection labelledBy='why-title'>
  <div class='home-section__header home-section__header--narrow'>
    <div>
      <p class='tf-text-label home-section__eyebrow'>Why TroubleFactory</p>
      <h2 id='why-title' class='tf-text-display-2xl'>
        A troubleshooting database, not a discussion board
      </h2>
      <p class='mt-3 tf-text-body-lg'>
        Built for engineers who need the exact fix for their stack — with proof
        it works in production.
      </p>
    </div>
  </div>

  <div class='home-features-grid'>
    {
      features.map((feature) => (
        <article class='home-feature-card'>
          <div class='home-feature-card__icon'>
            <Icon name={feature.icon} size={20} tone='brand' />
          </div>
          <h3 class='home-feature-card__title'>{feature.title}</h3>
          <p class='home-feature-card__body'>{feature.description}</p>
        </article>
      ))
    }
  </div>
</HomeSection>

---
// src/components/home/TrendingPanel.astro
import type { CollectionEntry } from 'astro:content';
import Icon from '@components/ui/Icon.astro';
import StatusBadge from '@components/ui/StatusBadge.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<aside class='home-trending' aria-labelledby='trending-title'>
  <div class='home-trending__header'>
    <h3 id='trending-title' class='home-trending__title'>
      <span class='inline-flex items-center gap-2'>
        <Icon name='flame' size={16} tone='warning' />
        Trending Problems
      </span>
    </h3>
    <StatusBadge variant='caution'>This week</StatusBadge>
  </div>

  {
    posts.length > 0 ? (
      <ol class='home-trending__list'>
        {posts.map((post, index) => (
          <li>
            <a href={`/cases/${post.id}/`} class='home-trending__item-link'>
              <span class='home-trending__index'>
                {String(index + 1).padStart(2, '0')}
              </span>
              <p class='home-trending__item-title'>{post.data.title}</p>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <p class='tf-text-body'>
        New verified cases will appear here as they are published.
      </p>
    )
  }
</aside>

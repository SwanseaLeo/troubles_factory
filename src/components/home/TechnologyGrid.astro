---
import type { TechnologyStat } from '../../utils/home-data';
import HomeSection from './HomeSection.astro';
import TechIcon from './TechIcon.astro';

interface Props {
  technologies: TechnologyStat[];
}

const { technologies } = Astro.props;
---

<HomeSection id='popular-technologies' labelledBy='technologies-title' muted>
  <div class='home-section__header'>
    <div>
      <p class='tf-text-label home-section__eyebrow'>Browse Technologies</p>
      <h2 id='technologies-title' class='tf-text-display-2xl'>
        Find fixes by stack
      </h2>
    </div>
    <a href='/cases/' class='home-section__link'>View all cases →</a>
  </div>

  <nav aria-label='Popular technologies'>
    <ul class='home-tech-grid'>
      {
        technologies.map((tech) => (
          <li>
            <a href={tech.href} class='home-tech-card'>
              <span class='home-tech-card__icon'>
                <TechIcon id={tech.id} />
              </span>
              <span class='min-w-0'>
                <span class='home-tech-card__label'>{tech.label}</span>
                <span class='home-tech-card__count'>
                  {tech.count} verified {tech.count === 1 ? 'case' : 'cases'}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</HomeSection>

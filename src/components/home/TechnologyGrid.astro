---
import type { TechnologyStat } from '../../utils/home-data';
import HomeSection from './HomeSection.astro';
import TechIcon from './TechIcon.astro';

interface Props {
  technologies: TechnologyStat[];
}

const { technologies } = Astro.props;
---

<HomeSection id='popular-technologies' labelledBy='technologies-title'>
  <div class='mb-10 flex flex-wrap items-end justify-between gap-4'>
    <div>
      <p class='tf-text-label mb-3'>Browse Technologies</p>
      <h2 id='technologies-title' class='tf-text-display-2xl dark:text-neutral-50'>
        Find fixes by stack
      </h2>
    </div>
    <a href='/cases/' class='tf-text-link text-sm font-medium'>
      View all cases →
    </a>
  </div>

  <nav aria-label='Popular technologies'>
    <ul class='grid gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4'>
      {
        technologies.map((tech) => (
          <li>
            <a
              href={tech.href}
              class='home-tech-card flex h-full items-center gap-4 rounded-tf-lg border border-tf-border bg-tf-surface p-4 dark:border-neutral-800 dark:bg-neutral-950'
            >
              <span class='flex h-11 w-11 shrink-0 items-center justify-center rounded-tf-md border border-tf-border bg-tf-surface-inset text-tf-brand dark:border-neutral-700 dark:bg-neutral-900 dark:text-blue-400'>
                <TechIcon id={tech.id} />
              </span>
              <span class='min-w-0'>
                <span class='block tf-text-display-lg text-sm'>
                  {tech.label}
                </span>
                <span class='tf-text-caption mt-0.5 block'>
                  {tech.count} verified {tech.count === 1 ? 'case' : 'cases'}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</HomeSection>

---
import type { TechnologyStat } from '../../utils/home-data';
import HomeSection from './HomeSection.astro';
import TechIcon from './TechIcon.astro';

interface Props {
  technologies: TechnologyStat[];
}

const { technologies } = Astro.props;
---

<HomeSection id='popular-technologies' labelledBy='technologies-title' muted>
  <div class='home-section__header'>
    <h2 id='technologies-title' class='tf-text-display-2xl'>
      Browse by Technology
    </h2>
    <a href='/cases/' class='home-section__link'>View all topics →</a>
  </div>

  <nav aria-label='Browse by technology'>
    <ul class='home-tech-grid'>
      {
        technologies.map((tech) => (
          <li>
            <a href={tech.href} class='home-tech-card'>
              <span class='home-tech-card__icon'>
                <TechIcon id={tech.id} />
              </span>
              <span class='home-tech-card__text'>
                <span class='home-tech-card__label'>{tech.label}</span>
                <span class='home-tech-card__count'>
                  {tech.count} {tech.count === 1 ? 'case' : 'cases'}
                </span>
              </span>
            </a>
          </li>
        ))
      }
      <li>
        <a href='/cases/' class='home-tech-card home-tech-card--more'>
          <span class='home-tech-card__icon'>
            <TechIcon id='more' />
          </span>
          <span class='home-tech-card__text'>
            <span class='home-tech-card__label'>More</span>
            <span class='home-tech-card__count'>View all</span>
          </span>
        </a>
      </li>
    </ul>
  </nav>
</HomeSection>

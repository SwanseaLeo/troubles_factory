---
import StatusBadge from '@components/ui/StatusBadge.astro';
import HomeSection from './HomeSection.astro';

const aiPoints = [
  'Hallucinated commands and missing prerequisites',
  'Unknown target environment and versions',
  'Cannot reproduce or verify the outcome',
] as const;

const factoryPoints = [
  'Verified procedures with expected output',
  'Version-specific environment details',
  'Production tested before publication',
  'Reproducible rollback and alternatives',
] as const;
---

<HomeSection id='why-not-ai' labelledBy='comparison-title' muted>
  <div class='home-section__header home-section__header--center'>
    <div>
      <p class='tf-text-label home-section__eyebrow'>Comparison</p>
      <h2 id='comparison-title' class='tf-text-display-2xl'>Why not AI?</h2>
      <p class='tf-text-body-lg mx-auto mt-3 max-w-2xl'>
        AI can suggest ideas. TroubleFactory documents fixes that were run,
        checked, and shipped in real environments.
      </p>
    </div>
  </div>

  <div class='home-comparison-grid'>
    <article class='home-comparison-card'>
      <h3 class='tf-text-display-lg text-lg'>AI Answers</h3>
      <ul class='home-comparison-list mt-4'>
        {
          aiPoints.map((point) => (
            <li class='home-comparison-list__item'>
              <span
                class='home-comparison-list__dot home-comparison-list__dot--danger'
                aria-hidden='true'
              />
              {point}
            </li>
          ))
        }
      </ul>
    </article>

    <article class='home-comparison-card home-comparison-card--highlight'>
      <div class='home-comparison-card__title-row'>
        <h3 class='tf-text-display-lg text-lg'>TroubleFactory</h3>
        <StatusBadge variant='verified' dot>Verified</StatusBadge>
      </div>
      <ul class='home-comparison-list'>
        {
          factoryPoints.map((point) => (
            <li class='home-comparison-list__item'>
              <span
                class='home-comparison-list__dot home-comparison-list__dot--success'
                aria-hidden='true'
              />
              {point}
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</HomeSection>

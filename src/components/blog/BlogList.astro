---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from '@components/ui/StatusBadge.astro';
import Tag from '@components/ui/Tag.astro';
import { formatVerifiedDate, inferCaseMeta } from '../../utils/home-data';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(date);
}
---

<ul class='browse-case-list'>
  {
    posts.map((post) => {
      const meta = inferCaseMeta(post);
      const href = `/cases/${post.id}/`;
      return (
        <li class='browse-case-item'>
          <a href={href} class='browse-case-item__link'>
            <div class='browse-case-item__header'>
              <div class='min-w-0'>
                <h2 class='browse-case-item__title'>{post.data.title}</h2>
                <p class='browse-case-item__description'>{post.data.description}</p>
              </div>
              <time
                datetime={post.data.pubDate.toISOString()}
                class='browse-case-item__date'
              >
                {formatDate(post.data.pubDate)}
              </time>
            </div>

            <dl class='browse-case-item__meta'>
              <div class='browse-case-item__meta-row'>
                <dt class='browse-case-item__meta-label'>Environment</dt>
                <dd class='browse-case-item__meta-value'>{meta.environment}</dd>
              </div>
              <div class='browse-case-item__meta-row'>
                <dt class='browse-case-item__meta-label'>Version</dt>
                <dd class='browse-case-item__meta-value browse-case-item__meta-value--mono'>
                  {meta.version}
                </dd>
              </div>
              <div class='browse-case-item__meta-row'>
                <dt class='browse-case-item__meta-label'>Framework</dt>
                <dd class='browse-case-item__meta-value'>{meta.framework}</dd>
              </div>
              <div class='browse-case-item__meta-row'>
                <dt class='browse-case-item__meta-label'>Verified</dt>
                <dd class='browse-case-item__meta-value'>
                  {formatVerifiedDate(post.data.pubDate)}
                </dd>
              </div>
            </dl>

            <div class='browse-case-item__footer'>
              <StatusBadge variant='documented' dot>
                Verified
              </StatusBadge>
              {
                post.data.tags.slice(0, 4).map((tag) => (
                  <Tag
                    label={tag}
                    href={`/cases/tags/${encodeURIComponent(tag.toLowerCase())}/`}
                    pill
                  >
                    {tag}
                  </Tag>
                ))
              }
            </div>
          </a>
        </li>
      );
    })
  }
</ul>

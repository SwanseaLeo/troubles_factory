---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
}

const { headings = [] } = Astro.props;
---

<aside aria-label='On this page'>
  <nav class='sticky top-6 hidden lg:block'>
    <p class='tf-text-label mb-3'>On this page</p>
    <ul class='border-l border-tf-border dark:border-neutral-700'>
      {
        headings.map((heading) => (
          <li>
            <a
              class='tf-focus-ring block border-l-2 border-transparent py-1.5 text-sm text-tf-text-secondary transition-colors hover:border-tf-text hover:text-tf-text dark:text-neutral-400 dark:hover:border-neutral-200 dark:hover:text-neutral-100'
              style={`padding-left: ${(heading.depth - 1) * 0.75 + 0.75}rem`}
              href={`#${heading.slug}`}
            >
              {heading.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>

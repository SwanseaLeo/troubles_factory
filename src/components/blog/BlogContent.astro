---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import StatusBadge from '@components/ui/StatusBadge.astro';
import Tag from '@components/ui/Tag.astro';

interface Props {
  pubDate: Date;
  author: string;
  imgSrc: ImageMetadata;
  imgAlt: string;
  title: string;
  description: string;
  tags: string[];
}

const { pubDate, author, imgSrc, imgAlt, title, description, tags } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(pubDate);
---

<article class='case-content w-full min-w-0 max-w-3xl tf-ui'>
  <a href='/cases/' class='tf-text-link text-sm' title='Back to cases'>&larr; Back to cases</a>

  <header class='not-prose mt-5'>
    <h1 class='tf-text-display-3xl md:text-4xl'>
      {title}
    </h1>
    <p class='tf-text-caption mt-3'>
      Published <time datetime={pubDate.toISOString()}>{formattedDate}</time> by {author}
    </p>
  </header>

  <section
    class='not-prose my-6 rounded-tf-lg border border-tf-border bg-tf-surface-inset p-4 md:p-5 dark:border-neutral-800 dark:bg-neutral-900'
    aria-labelledby='case-summary-title'
  >
    <div class='flex flex-wrap items-center gap-2'>
      <h2 id='case-summary-title' class='tf-text-display-lg text-base'>
        Case summary
      </h2>
      <StatusBadge variant='documented'>Verified</StatusBadge>
    </div>
    <p class='tf-text-body mt-3 md:text-base'>
      {description}
    </p>
    {
      tags.length > 0 && (
        <ul class='mt-4 flex flex-wrap gap-2'>
          {tags.map((tag) => (
            <li>
              <Tag
                label={tag}
                href={`/cases/tags/${encodeURIComponent(tag.toLowerCase())}/`}
              >
                {tag}
              </Tag>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <div class='not-prose my-6 aspect-[2/1] overflow-hidden rounded-tf-lg border border-tf-border-strong dark:border-neutral-700'>
    <Image
      src={imgSrc}
      alt={imgAlt}
      width={1200}
      height={600}
      class='h-full w-full rounded object-cover'
    />
  </div>
  <div class='case-body prose prose-slate md:prose-lg'>
    <slot />
  </div>
  <footer class='mt-12 border-t border-tf-border pt-5 dark:border-neutral-800'>
    <p class='tf-text-caption'>Written by {author}</p>
    <a class='tf-text-link mt-2 inline-block text-sm' href='/cases/' title='Back to cases'>
      &larr; Back to cases
    </a>
  </footer>
</article>

<style>
  .case-body > :global(h2:first-of-type) {
    display: none;
  }

  .case-body {
    margin-top: 2.5rem;
  }

  .case-body :global(h3) {
    margin-top: 3rem;
    border-top: 1px solid rgb(0 0 0 / 0.1);
    padding-top: 2rem;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    letter-spacing: 0;
    color: #171717;
  }

  .case-body :global(h4) {
    margin-top: 2rem;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    letter-spacing: 0;
    color: #262626;
  }

  .case-body :global(p),
  .case-body :global(li) {
    line-height: 1.8;
  }

  .case-body :global(strong) {
    color: #171717;
  }

  .case-body :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid #262626;
    border-radius: 6px;
    background: #171717;
    scrollbar-color: #737373 #262626;
    scrollbar-width: thin;
  }

  .case-body :global(pre::-webkit-scrollbar) {
    height: 10px;
    background: #262626;
  }

  .case-body :global(pre::-webkit-scrollbar-track) {
    border: 0;
    background: #262626;
  }

  .case-body :global(pre::-webkit-scrollbar-thumb) {
    border: 2px solid #262626;
    border-radius: 5px;
    background: #737373;
  }

  .case-body :global(pre::-webkit-scrollbar-button) {
    display: none;
  }

  .case-body :global(:not(pre) > code) {
    border-radius: 4px;
    background: #f3f4f6;
    padding: 0.15rem 0.35rem;
    color: #b42318;
  }

  .case-body :global(blockquote) {
    border-left-color: #d97706;
    background: #fffbeb;
    padding: 0.75rem 1rem;
    color: #525252;
  }

  .case-body :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }

  @media (max-width: 767px) {
    .case-body {
      margin-top: 2rem;
    }

    .case-body :global(h3) {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
    }
  }
</style>

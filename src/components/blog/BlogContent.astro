---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  pubDate: Date;
  author: string;
  imgSrc: ImageMetadata;
  imgAlt: string;
  title: string;
  description: string;
  tags: string[];
}

const { pubDate, author, imgSrc, imgAlt, title, description, tags } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(pubDate);
---

<article class='case-content w-full min-w-0 max-w-3xl poppins'>
  <a href='/cases/' title='Back to cases'>&larr; Back to cases</a>

  <header class='not-prose mt-5'>
    <h1 class='outfit text-3xl font-semibold leading-tight text-black md:text-4xl'>
      {title}
    </h1>
    <p class='mt-3 poppins text-sm text-black/50'>
      Published <time datetime={pubDate.toISOString()}>{formattedDate}</time> by {author}
    </p>
  </header>

  <section
    class='not-prose my-6 rounded-lg border border-black/10 bg-[#f7f8f8] p-4 md:p-5'
    aria-labelledby='case-summary-title'
  >
    <div class='flex flex-wrap items-center gap-2'>
      <h2 id='case-summary-title' class='outfit text-base font-semibold text-black'>
        Case summary
      </h2>
      <span class='rounded border border-emerald-700/20 bg-emerald-50 px-2 py-1 poppins text-xs font-medium text-emerald-800'>
        Documented case
      </span>
    </div>
    <p class='mt-3 poppins text-sm leading-relaxed text-black/70 md:text-base'>
      {description}
    </p>
    {
      tags.length > 0 && (
        <div class='mt-4 flex flex-wrap gap-2' aria-label='Case topics'>
          {tags.map((tag) => (
            <a
              href={`/cases/tags/${encodeURIComponent(tag.toLowerCase())}/`}
              class='rounded border border-black/10 bg-white px-2 py-1 poppins text-xs text-black/60 hover:border-black/20 hover:text-black'
            >
              {tag}
            </a>
          ))}
        </div>
      )
    }
  </section>

  <div class='not-prose my-6 aspect-[2/1] overflow-hidden rounded-lg border border-black/15'>
    <Image
      src={imgSrc}
      alt={imgAlt}
      width={1200}
      height={600}
      class='h-full w-full rounded object-cover'
    />
  </div>
  <div class='case-body prose prose-slate md:prose-lg'>
    <slot />
  </div>
  <footer class='mt-12 border-t border-black/10 pt-5'>
    <p class='text-sm text-slate-600'>Written by {author}</p>
    <a class='mt-2 inline-block' href='/cases/' title='Back to cases'>
      &larr; Back to cases
    </a>
  </footer>
</article>

<style>
  .case-body > :global(h2:first-of-type) {
    display: none;
  }

  .case-body {
    margin-top: 2.5rem;
  }

  .case-body :global(h3) {
    margin-top: 3rem;
    border-top: 1px solid rgb(0 0 0 / 0.1);
    padding-top: 2rem;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    letter-spacing: 0;
    color: #171717;
  }

  .case-body :global(h4) {
    margin-top: 2rem;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    letter-spacing: 0;
    color: #262626;
  }

  .case-body :global(p),
  .case-body :global(li) {
    line-height: 1.8;
  }

  .case-body :global(strong) {
    color: #171717;
  }

  .case-body :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid #262626;
    border-radius: 6px;
    background: #171717;
    scrollbar-color: #737373 #262626;
    scrollbar-width: thin;
  }

  .case-body :global(pre::-webkit-scrollbar) {
    height: 10px;
    background: #262626;
  }

  .case-body :global(pre::-webkit-scrollbar-track) {
    border: 0;
    background: #262626;
  }

  .case-body :global(pre::-webkit-scrollbar-thumb) {
    border: 2px solid #262626;
    border-radius: 5px;
    background: #737373;
  }

  .case-body :global(pre::-webkit-scrollbar-button) {
    display: none;
  }

  .case-body :global(:not(pre) > code) {
    border-radius: 4px;
    background: #f3f4f6;
    padding: 0.15rem 0.35rem;
    color: #b42318;
  }

  .case-body :global(blockquote) {
    border-left-color: #d97706;
    background: #fffbeb;
    padding: 0.75rem 1rem;
    color: #525252;
  }

  .case-body :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }

  @media (max-width: 767px) {
    .case-body {
      margin-top: 2rem;
    }

    .case-body :global(h3) {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
    }
  }
</style>

---
import SidebarLink from '@components/ui/SidebarLink.astro';
import type { CollectionEntry } from 'astro:content';
import type { TagEntry } from '../../utils/cases';

interface Props {
  tags: TagEntry[];
  recentPosts: CollectionEntry<'blog'>[];
  caseCount: number;
  activePath?: string;
}

const { tags, recentPosts, caseCount, activePath = Astro.url.pathname } =
  Astro.props;

function isActive(href: string) {
  const normalized = href.replace(/\/$/, '');
  const path = activePath.replace(/\/$/, '');
  return path === normalized || path.startsWith(`${normalized}/`);
}

function isAllCasesActive() {
  const path = activePath.replace(/\/$/, '');
  return (path === '/cases' || path.startsWith('/cases/')) && !path.includes('/tags/');
}
---

<div class='flex h-full flex-col gap-5'>
  <div>
    <p class='tf-text-label'>Index</p>
    <p class='tf-text-body mt-0.5 text-sm'>
      {caseCount} {caseCount === 1 ? 'case' : 'cases'} · {tags.length}{' '}
      {tags.length === 1 ? 'topic' : 'topics'}
    </p>
  </div>

  <nav aria-label='Quick links'>
    <h2 class='tf-text-label'>Quick links</h2>
    <ul class='mt-1.5 space-y-0.5'>
      <li>
        <SidebarLink href='/search' active={isActive('/search')} class='px-3 py-2'>
          Search
        </SidebarLink>
      </li>
      <li>
        <SidebarLink href='/cases/' active={isAllCasesActive()} class='px-3 py-2'>
          All cases
        </SidebarLink>
      </li>
    </ul>
  </nav>

  {
    tags.length > 0 && (
      <nav class='min-h-0' aria-label='Topics'>
        <h2 class='tf-text-label'>Topics</h2>
        <ul class='tf-sidebar-scroll mt-1.5 max-h-64 space-y-0.5 overflow-y-auto'>
          {tags.map((tag) => {
            const href = `/cases/tags/${tag.slug}/`;
            return (
              <li>
                <SidebarLink
                  href={href}
                  active={isActive(href)}
                  class='flex items-center justify-between gap-2 px-3 py-2'
                >
                  <span class='truncate'>{tag.label}</span>
                  <span
                    class:list={[
                      'shrink-0 text-xs tabular-nums',
                      isActive(href) ? 'text-tf-brand-active' : 'text-tf-text-muted',
                    ]}
                  >
                    {tag.count}
                  </span>
                </SidebarLink>
              </li>
            );
          })}
        </ul>
      </nav>
    )
  }

  {
    recentPosts.length > 0 && (
      <nav class='min-h-0 flex-1' aria-label='Recent cases'>
        <h2 class='tf-text-label'>Recent</h2>
        <ul class='tf-sidebar-scroll mt-1.5 space-y-0.5 overflow-y-auto'>
          {recentPosts.slice(0, 5).map((post) => {
            const href = `/cases/${post.id}/`;
            return (
              <li>
                <SidebarLink href={href} active={isActive(href)} muted class='px-3 py-2 leading-snug'>
                  {post.data.title}
                </SidebarLink>
              </li>
            );
          })}
        </ul>
      </nav>
    )
  }
</div>

---
import SocialIcon from '@components/generic/SocialIcon.astro';

type SocialIconName = 'github' | 'twitter' | 'linkedin' | 'rss';

interface Props {
  pageTitle?: string;
}

const navigationItems = [
  { name: 'Home', url: '/' },
  { name: 'Cases', url: '/cases/' },
];

const socialIcons: Array<{ name: string; url: string; icon: SocialIconName }> = [
  { name: 'RSS', url: '/feed.xml', icon: 'rss' },
];

const { pageTitle } = Astro.props;
---

<header class='border-b-4 border-black flex justify-between p-6 items-center'>
  {pageTitle && <h1 class='hidden'>{pageTitle}</h1>}
  <a href='/' title='Back to Home'>
    <span class='sr-only'>Troubles Factory</span>
    <img
      src='/logo_a.png'
      alt='Troubles Factory'
      class='h-10 md:h-14 w-auto'
      loading='eager'
      decoding='async'
    />
  </a>
  <nav class='hidden md:inline-block'>
    <h2 class='hidden'>Navigation</h2>
    <ul class='flex gap-8 poppins'>
      {
        navigationItems.map((item) => (
          <li>
            <a
              class='text-lg font-medium hover:text-green-700 hover:underline transition-all duration-150 ease-in-out'
              href={item.url}
              title={`Go to ${item.name}`}
            >
              {item.name}
            </a>
          </li>
        ))
      }
      {
        socialIcons.map((item) => (
          <li>
            <a
              href={item.url}
              class='hover:text-green-700 hover:underline transition-all duration-150 ease-in-out'
              target='_blank'
              rel='noopener'
              title={`Open ${item.name}`}
            >
              <SocialIcon icon={item.icon} class='h-6 w-6' />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <nav class='md:hidden flex'>
    <h2 class='hidden'>Mobile Navigation</h2>
    <ul>
      <li><a href='/cases/'>Cases</a></li>
    </ul>
  </nav>
</header>

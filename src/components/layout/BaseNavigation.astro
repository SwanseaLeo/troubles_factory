---
import SocialIcon from '@components/generic/SocialIcon.astro';
import SearchBar from '@components/layout/SearchBar.astro';
import { communityLinks } from '../../data/community-links';

type SocialIconName = 'github' | 'twitter' | 'linkedin' | 'rss' | 'discord';

interface Props {
  pageTitle?: string;
  variant?: 'default' | 'minimal';
}

const navigationItems = [
  { name: 'Home', url: '/' },
  { name: 'Cases', url: '/cases/' },
];

const discordLink = communityLinks.find((link) => link.type === 'discord');

const socialIcons: Array<{ name: string; url: string; icon: SocialIconName }> = [
  ...(discordLink
    ? [{ name: 'Discord', url: discordLink.url, icon: 'discord' as const }]
    : []),
  { name: 'RSS', url: '/feed.xml', icon: 'rss' },
];

const { pageTitle, variant = 'default' } = Astro.props;
const isMinimal = variant === 'minimal';

const navLinkClass =
  'tf-ui text-sm font-medium text-tf-text-secondary transition-colors hover:text-tf-brand dark:text-neutral-300 dark:hover:text-blue-400';
const iconLinkClass =
  'tf-focus-ring rounded-tf-md p-1 text-tf-text-muted transition-colors hover:text-tf-brand dark:text-neutral-400 dark:hover:text-blue-400';
---

<header
  class:list={[
    'flex flex-wrap items-center gap-4 border-b border-tf-border bg-tf-surface p-4 md:gap-6 md:px-6 dark:border-neutral-800 dark:bg-neutral-950',
    !isMinimal && 'md:pb-4',
  ]}
>
  {pageTitle && <span class='sr-only'>{pageTitle}</span>}
  <a href='/' class='tf-focus-ring rounded-tf-md' title='Back to Home'>
    <span class='sr-only'>TroubleFactory</span>
    <img
      src='/logo_a.png'
      alt='TroubleFactory'
      class='h-10 w-auto md:h-14'
      width='160'
      height='56'
      loading='eager'
      decoding='async'
    />
  </a>
  {
    !isMinimal && (
      <div class='order-last w-full md:order-none md:ml-auto md:w-72 lg:w-96'>
        <SearchBar />
      </div>
    )
  }
  <nav
    class:list={['hidden md:block', isMinimal && 'md:ml-auto']}
    aria-label='Primary'
  >
    <ul class='flex items-center gap-6'>
      {
        navigationItems.map((item) => (
          <li>
            <a class:list={[navLinkClass, 'tf-focus-ring text-base']} href={item.url}>
              {item.name}
            </a>
          </li>
        ))
      }
      {
        socialIcons.map((item) => (
          <li>
            <a
              href={item.url}
              class={iconLinkClass}
              target='_blank'
              rel='noopener noreferrer'
              aria-label={`Open ${item.name}`}
            >
              <SocialIcon icon={item.icon} class='h-6 w-6' />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <nav class='ml-auto flex items-center md:hidden' aria-label='Mobile primary'>
    <ul class='flex items-center gap-4'>
      <li>
        <a href='/cases/' class={navLinkClass}>Cases</a>
      </li>
      {
        socialIcons.map((item) => (
          <li>
            <a
              href={item.url}
              class={iconLinkClass}
              target='_blank'
              rel='noopener noreferrer'
              aria-label={`Open ${item.name}`}
            >
              <SocialIcon icon={item.icon} class='h-5 w-5' />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

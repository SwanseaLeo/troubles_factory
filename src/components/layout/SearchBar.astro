---
// src/components/layout/SearchBar.astro
import { searchFieldClasses } from '../../styles/design-system';

interface Props {
  size?: 'default' | 'hero';
  autofocus?: boolean;
}

const { size = 'default', autofocus = false } = Astro.props;
const isHero = size === 'hero';
const placeholder = isHero
  ? 'Errors, tools, versions…'
  : 'Search errors, tools, topics…';
---

<div
  class:list={[searchFieldClasses(size), 'relative w-full']}
  data-tf-search
  data-tf-search-size={size}
>
  <input
    type='search'
    autocomplete='off'
    placeholder={placeholder}
    aria-label='Search cases'
    class:list={[
      'tf-search-input tf-focus-ring',
      isHero ? 'tf-search-input--hero' : 'tf-search-input--default',
    ]}
    data-tf-search-input
    autofocus={autofocus || undefined}
  />
  {
    isHero && (
      <button
        type='button'
        class='tf-search-submit tf-focus-ring'
        data-tf-search-submit
      >
        Search
      </button>
    )
  }
  <ul
    class:list={[
      'tf-search-results hidden',
      !isHero && 'tf-search-results--default',
    ]}
    data-tf-search-results
  >
  </ul>
</div>

<script>
  import '../../scripts/search-bar.ts';
</script>

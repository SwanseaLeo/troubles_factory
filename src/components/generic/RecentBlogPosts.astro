---
import { getCollection } from 'astro:content';
import BlogList from '../blog/BlogList.astro';

interface Props {
  count?: number;
}

const { count } = Astro.props;

const posts = await getCollection('blog').then((posts) =>
  posts
    .sort((a, b) => b.id.localeCompare(a.id))
    .slice(0, count ?? 3)
);
---

<section class='mt-8 border-t border-black/10 pt-8'>
  <div class='mb-4 flex items-center justify-between gap-4'>
    <h2 class='outfit text-xl font-semibold md:text-2xl'>Recent cases</h2>
    <a href='/cases/' class='poppins text-sm text-[#0066cc] hover:underline'>
      View all cases
    </a>
  </div>
  <BlogList posts={posts} />
</section>

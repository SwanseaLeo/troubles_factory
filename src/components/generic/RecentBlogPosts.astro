---
import { getCollection } from 'astro:content';
import BlogList from '../blog/BlogList.astro';

interface Props {
  count?: number;
}

const { count } = Astro.props;

const posts = await getCollection('blog').then((items) =>
  items
    .sort((a, b) => b.id.localeCompare(a.id))
    .slice(0, count ?? 3),
);
---

<section class='mt-8 border-t border-tf-border pt-8 dark:border-neutral-800'>
  <div class='mb-4 flex items-center justify-between gap-4'>
    <h2 class='tf-text-display-xl'>Recent cases</h2>
    <a href='/cases/' class='tf-text-link text-sm font-medium'>View all cases</a>
  </div>
  <BlogList posts={posts} />
</section>

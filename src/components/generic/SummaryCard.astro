---
import { Image } from 'astro:assets';
import { Card } from '@eliancodes/brutal-ui';

interface Props {
  title: string;
  imgSrc: ImageMetadata;
  imgAlt: string;
  description: string;
  imgHref?: string;
}

const { title, imgAlt, imgSrc, description, imgHref } = Astro.props;
---

<Card color='white'>
  <div class='flex h-full flex-col'>
    <h3 class='poppins text-lg md:text-xl'>{title}</h3>
    {
      imgHref ? (
        <a
          href={imgHref}
          title={title}
          class='my-4 block h-56 rounded-lg border-[3px] border-black transition-colors hover:bg-green-theme'
        >
          <Image
            src={imgSrc}
            alt={imgAlt}
            width={800}
            height={400}
            class='rounded h-full w-full object-cover'
          />
        </a>
      ) : (
        <div class='my-4 h-56 rounded-lg border-[3px] border-black'>
          <Image
            src={imgSrc}
            alt={imgAlt}
            width={800}
            height={400}
            class='rounded h-full w-full object-cover'
          />
        </div>
      )
    }
    <p class='poppins'>{description}</p>
    <div class='mt-auto'>
      <slot />
    </div>
  </div>
</Card>

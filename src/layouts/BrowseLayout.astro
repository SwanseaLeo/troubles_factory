---
import BrowseMobileNav from '@components/layout/BrowseMobileNav.astro';
import BrowseSidebar from '@components/layout/BrowseSidebar.astro';
import Layout from '@layouts/Default.astro';
import { buildTagIndex, getPublishedCases } from '../utils/cases';
import '../styles/browse.css';

interface Props {
  title: string;
  description: string;
  pageTitle?: string;
  ogImage?: URL;
}

const { title, description, pageTitle, ogImage } = Astro.props;

const posts = await getPublishedCases();
const tags = buildTagIndex(posts);
---

<Layout {title} {description} {pageTitle} {ogImage} classList='browse-page'>
  <main id='main-content' class='browse-layout'>
    <aside class='browse-layout__sidebar' aria-label='Browse cases'>
      <div class='browse-layout__sidebar-inner tf-sidebar-scroll'>
        <BrowseSidebar tags={tags} recentPosts={posts} caseCount={posts.length} />
      </div>
    </aside>

    <div class='browse-layout__main'>
      <BrowseMobileNav tags={tags} caseCount={posts.length} />
      <slot />
    </div>
  </main>

  <script>
    function initBrowseMobileNav() {
      const toggle = document.querySelector<HTMLButtonElement>('[data-browse-mobile-toggle]');
      const panel = document.querySelector<HTMLElement>('[data-browse-mobile-panel]');
      if (!toggle || !panel) return;

      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        panel.hidden = expanded;
      });
    }

    initBrowseMobileNav();
    document.addEventListener('astro:page-load', initBrowseMobileNav);
  </script>
</Layout>

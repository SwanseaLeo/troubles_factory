---
import BaseHead from '../components/layout/BaseHead.astro';
import BaseNavigation from '@components/layout/BaseNavigation.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  classList?: string;
  pageTitle?: string;
  ogImage?: URL;
  keywords?: string;
  ogSiteName?: string;
  robots?: string;
  navVariant?: 'default' | 'minimal';
}

const {
  title,
  description,
  classList,
  pageTitle,
  ogImage,
  keywords,
  ogSiteName,
  robots,
  navVariant,
} = Astro.props;
---

<html lang='en' class='h-full'>
  <BaseHead
    ogImage={ogImage}
    title={title}
    description={description}
    keywords={keywords}
    ogSiteName={ogSiteName}
    robots={robots}
  >
    <slot name='head' />
  </BaseHead>

  <body class:list={[classList]}>
    <a
      href='#main-content'
      class='sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-tf-md focus:border focus:border-tf-border focus:bg-tf-surface focus:px-4 focus:py-2 focus:shadow-tf-md tf-ui text-sm font-medium text-tf-text'
    >
      Skip to main content
    </a>
    <BaseNavigation {pageTitle} variant={navVariant} />
    <slot />
    <SiteFooter />
  </body>
</html>

---
import CaseHero from '@components/case/CaseHero.astro';
import CaseLeftNav from '@components/case/CaseLeftNav.astro';
import CaseMobileToc from '@components/case/CaseMobileToc.astro';
import CaseProse from '@components/case/CaseProse.astro';
import CaseRightSidebar from '@components/case/CaseRightSidebar.astro';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import type { CaseDisplayMeta } from '../utils/home-data';
import Layout from './Default.astro';
import '../styles/case.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  author: string;
  pubDate: Date;
  headings?: Heading[];
  description: string;
  title: string;
  imgSrc: ImageMetadata;
  tags: string[];
  slug: string;
  relatedCases: CollectionEntry<'blog'>[];
  versions: string[];
  meta: CaseDisplayMeta;
}

const {
  author,
  pubDate,
  headings,
  description,
  title,
  imgSrc,
  tags,
  slug,
  relatedCases,
  versions,
  meta,
} = Astro.props;

const ogImage = new URL(`/v1/generate/og/${slug}.png`, Astro.url);
const sectionHeadings = (headings ?? []).filter((heading) => heading.depth === 3);
---

<Layout title={title} description={description} ogImage={ogImage} classList='case-page'>
  <main id='main-content' class='case-layout'>
    <CaseLeftNav headings={sectionHeadings} />

    <div class='case-main'>
      <CaseMobileToc headings={sectionHeadings} />
      <CaseHero
        {title}
        {description}
        {author}
        {pubDate}
        imgSrc={imgSrc}
        {tags}
        {meta}
      />
      <CaseProse {author}>
        <slot />
      </CaseProse>
    </div>

    <CaseRightSidebar
      {author}
      {pubDate}
      {tags}
      {meta}
      {versions}
      {relatedCases}
      {slug}
    />
  </main>

  <script>
    import '../scripts/case-page.ts';
  </script>
</Layout>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    html:has(.case-page) {
      scroll-behavior: smooth;
    }
  }
</style>
